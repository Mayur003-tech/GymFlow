    {
      "parameters": {
        "jsCode": "\nconst members = $input.all();\n\nconst today = new Date().toLocaleDateString(\"en-CA\", {\n  timeZone: \"Asia/Kolkata\"\n});\n\nconst [year, month, day] = today.split(\"-\").map(Number);\n\nconst todayDate = Date.UTC(year, month - 1, day);\n\nlet totalMembers = members.length;\nlet activeMembers = 0;\nlet expiredMembers = 0;\nlet expiringInNext7Days = 0;\n\nfor (const item of members) {\n  const member = item.json;\n\n  if (!member.Expiry_Date) continue;\n\n  const [y, m, d] = member.Expiry_Date.split(\"-\").map(Number);\n\n  const expiryDate = Date.UTC(y, m - 1, d);\n\n  const daysRemaining = Math.round(\n    (expiryDate - todayDate) / (1000 * 60 * 60 * 24)\n  );\n\n  if (daysRemaining < 0) {\n    expiredMembers++;\n  } else {\n    if (member.Membership_Status === \"Active\") {\n      activeMembers++;\n    }\n\n    if (\n      member.Membership_Status === \"Active\" &&\n      daysRemaining <= 7\n    ) {\n      expiringInNext7Days++;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    Report_Date: today,\n    Total_Members: totalMembers,\n    Active_Members: activeMembers,\n    Expired_Members: expiredMembers,\n    Expiring_In_Next_7_Days: expiringInNext7Days\n  }\n}];\n"
      },
