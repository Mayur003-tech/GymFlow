    {
      "parameters": {
        "jsCode": "\nconst planDurations = {\n  Daily: 1,\n  Weekly: 7,\n  Monthly: 30\n};\n\nconst members = $input.all();\n\nreturn members.map(item => {\n  const data = item.json;\n\n  const name = data[\"Full Name\"];\n  const phone = String(data[\"Phone Number\"]);\n  const joinDate = data[\"Join Date\"];\n  const plan = data[\"Membership Plan\"];\n\n  // Validate membership plan\n  if (!planDurations[plan]) {\n    throw new Error(`Invalid membership plan: ${plan}`);\n  }\n\n  // Calculate expiry date\n  const [year, month, day] = joinDate.split(\"-\").map(Number);\n\n  const expiry = new Date(\n    Date.UTC(year, month - 1, day + planDurations[plan] - 1)\n  );\n\n  const expiryDate = expiry.toISOString().slice(0, 10);\n\n  // Generate unique Member ID\n  const memberId = `GYM-${Date.now()}-${Math.floor(Math.random() * 1000)}`;\n\n  return {\n    json: {\n      Member_ID: memberId,\n      Name: name,\n      Phone: phone,\n      Join_Date: joinDate,\n      Plan: plan,\n      Expiry_Date: expiryDate,\n      Payment_Status: \"Pending\",\n      Membership_Status: \"Active\",\n      Registered_At: data.submittedAt\n    }\n  };\n});\n"
      },
